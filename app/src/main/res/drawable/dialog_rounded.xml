<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded Macchiato mantle background for every popup. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetTop="16dp"
    android:insetRight="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="#1E2030" />
        <corners android:radius="8dp" />
        <stroke android:width="1dp" android:color="#363A4F" />
    </shape>
</inset>
