<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toggle_brightness"
        android:enabled="true"
        android:icon="@drawable/shortcut_brightness"
        android:shortcutShortLabel="@string/shortcut_brightness"
        android:shortcutLongLabel="@string/shortcut_brightness">
        <intent
            android:action="nz.co.thor.brightnesscontrol.TOGGLE_BRIGHTNESS"
            android:targetPackage="nz.co.thor.brightnesscontrol"
            android:targetClass="nz.co.thor.brightnesscontrol.ToggleActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="toggle_volume"
        android:enabled="true"
        android:icon="@drawable/shortcut_volume"
        android:shortcutShortLabel="@string/shortcut_volume"
        android:shortcutLongLabel="@string/shortcut_volume">
        <intent
            android:action="nz.co.thor.brightnesscontrol.TOGGLE_VOLUME"
            android:targetPackage="nz.co.thor.brightnesscontrol"
            android:targetClass="nz.co.thor.brightnesscontrol.ToggleActivity" />
    </shortcut>
</shortcuts>
